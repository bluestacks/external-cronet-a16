    name: "tot_cronet_third_party_perfetto_src_base_perfetto_base_default_platform__testing__concatenated_headers_common",
    cmd: "python $(location components/cronet/gn2bp/headers_copy.py) --gen-dir $(genDir) --headers " +
         "$(locations :tot_cronet_third_party_perfetto_gn_gen_buildflags__testing)",
    host_supported: true,
    host_cross_supported: false,
    out: [
        "third_party/perfetto/build_config/perfetto_build_flags.h",
    ],
    export_include_dirs: [
        "third_party/perfetto/build_config/",
    ],
    tool_files: [
        ":tot_cronet_third_party_perfetto_gn_gen_buildflags__testing",
        "components/cronet/gn2bp/headers_copy.py",
    ],
    apex_available: [
        "com.android.tethering",
    ],
}

