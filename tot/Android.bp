    name: "tot_cronet_third_party_perfetto_include_perfetto_tracing_tracing__testing__concatenated_headers_common",
    cmd: "python $(location components/cronet/gn2bp/headers_copy.py) --gen-dir $(genDir) --headers " +
         "$(locations :tot_cronet_1baaa48e_android_cpp_gen__testing_h) " +
         "$(locations :tot_cronet_1baaa48e_android_zero_gen__testing_h) " +
         "$(locations :tot_cronet_1baaa48e_ftrace_cpp_gen__testing_h) " +
         "$(locations :tot_cronet_1baaa48e_ftrace_zero_gen__testing_h) " +
