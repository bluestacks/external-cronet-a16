                "-DANDROID_NDK_VERSION_ROLL=r28_1",
                "-DHAVE_SYS_UIO_H",
                "-DHAVE___CXA_THREAD_ATEXIT_IMPL",
                "-D__ANDROID_UNAVAILABLE_SYMBOLS_ARE_WEAK__",
            ],
        },
        android_arm64: {
            srcs: [
                "buildtools/third_party/libc++abi/cxa_demangle_stub.cc",
            ],
            cflags: [
                "-DANDROID",
                "-DANDROID_NDK_VERSION_ROLL=r28_1",
                "-DHAVE_SYS_UIO_H",
                "-DHAVE___CXA_THREAD_ATEXIT_IMPL",
                "-D__ANDROID_UNAVAILABLE_SYMBOLS_ARE_WEAK__",
                "-D__ARM_NEON__=1",
                "-O2",
                "-mno-outline",
            ],
        },
        android_riscv64: {
            srcs: [
                "buildtools/third_party/libc++abi/cxa_demangle_stub.cc",
            ],
            cflags: [
                "-DANDROID",
                "-DANDROID_NDK_VERSION_ROLL=r28_1",
                "-DHAVE_SYS_UIO_H",
                "-DHAVE___CXA_THREAD_ATEXIT_IMPL",
                "-D__ANDROID_UNAVAILABLE_SYMBOLS_ARE_WEAK__",
            ],
        },
        android_x86: {
            srcs: [
                "buildtools/third_party/libc++abi/cxa_demangle_stub.cc",
            ],
            cflags: [
                "-DANDROID",
                "-DANDROID_NDK_VERSION_ROLL=r28_1",
                "-DHAVE_SYS_UIO_H",
                "-DHAVE___CXA_THREAD_ATEXIT_IMPL",
                "-D__ANDROID_UNAVAILABLE_SYMBOLS_ARE_WEAK__",
                "-msse3",
            ],
        },
        android_x86_64: {
            srcs: [
                "buildtools/third_party/libc++abi/cxa_demangle_stub.cc",
            ],
            cflags: [
                "-DANDROID",
                "-DANDROID_NDK_VERSION_ROLL=r28_1",
                "-DHAVE_SYS_UIO_H",
                "-DHAVE___CXA_THREAD_ATEXIT_IMPL",
                "-D__ANDROID_UNAVAILABLE_SYMBOLS_ARE_WEAK__",
                "-O2",
                "-msse3",
            ],
        },
        host: {
            srcs: [
                "third_party/libc++abi/src/src/cxa_demangle.cpp",
            ],
            cflags: [
                "-DCR_SYSROOT_KEY=20250129T203412Z-1",
                "-DNO_UNWIND_TABLES",
                "-DUSE_AURA=1",
                "-DUSE_OZONE=1",
                "-DUSE_UDEV",
                "-D_FILE_OFFSET_BITS=64",
                "-D_LARGEFILE64_SOURCE",
                "-D_LARGEFILE_SOURCE",
                "-O2",
                "-fno-asynchronous-unwind-tables",
                "-fno-unwind-tables",
                "-msse3",
            ],
        },
    },
}

// GN: //gn:default_deps
cc_defaults {
    name: "tot_cronet_cc_defaults",
    cflags: [
        "-DBORINGSSL_SHARED_LIBRARY",
        "-DGOOGLE_PROTOBUF_NO_RTTI",
        "-Wno-ambiguous-reversed-operator",
        "-Wno-c++11-narrowing",
        "-Wno-error=return-type",
        "-Wno-invalid-constexpr",
        "-Wno-macro-redefined",
        "-Wno-missing-field-initializers",
        "-Wno-non-virtual-dtor",
        "-Wno-null-pointer-subtraction",
        "-Wno-nullability-completeness",
        "-Wno-sign-compare",
        "-Wno-sign-promo",
        "-Wno-unknown-warning-option",
        "-Wno-unreachable-code-loop-increment",
        "-Wno-unused-parameter",
        "-fPIC",
        "-fprofile-list=external/cronet/exclude_coverage.list",
    ],
    stl: "none",
    cpp_std: "c++17",
    apex_available: [
        "com.android.tethering",
    ],
    min_sdk_version: "30",
    c_std: "gnu11",
    include_build_directory: false,
    target: {
        android: {
            shared_libs: [
                "libmediandk",
            ],
            header_libs: [
                "jni_headers",
            ],
        },
        host: {
            cflags: [
                "-UANDROID",
            ],
            compile_multilib: "64",
        },
    },
}

// GN: //components/cronet/android:api_version
java_genrule {
    name: "tot_cronet_components_cronet_android_api_version",
    cmd: "mkdir -p $(genDir)/components/cronet/android/templates/org/chromium/net &&  " +
         "$(location build/util/version.py) " +
         "--official " +
         "-f " +
         "'$(location chrome/VERSION)' " +
         "-f " +
         "'$(location build/util/LASTCHANGE)' " +
         "-e " +
         "API_LEVEL=37 " +
         "-o " +
         "'$(out)' " +
         "'$(location components/cronet/android/api/src/org/chromium/net/ApiVersion.template)'",
    out: [
        "components/cronet/android/templates/org/chromium/net/ApiVersion.java",
    ],
    tool_files: [
        "build/util/LASTCHANGE",
        "build/util/android_chrome_version.py",
        "build/util/version.py",
        "chrome/VERSION",
        "components/cronet/android/api/src/org/chromium/net/ApiVersion.template",
    ],
    visibility: [
        "//external/cronet:__subpackages__",
    ],
}

