        "third_party/perfetto/protos/perfetto/trace/trace_packet_defaults.gen.h",
        "third_party/perfetto/protos/perfetto/trace/ui_state.gen.h",
    ],
    export_include_dirs: [
        ".",
        "protos",
        "third_party/perfetto/",
    ],
    apex_available: [
        "com.android.tethering",
    ],
    visibility: [
        "//external/cronet:__subpackages__",
    ],
}

