// GN: //third_party/perfetto/gn:gen_buildflags
cc_genrule {
    name: "tot_cronet_third_party_perfetto_gn_gen_buildflags",
    cmd: "mkdir -p $(genDir)/third_party/perfetto/build_config &&  " +
         "echo '--flags PERFETTO_ANDROID_BUILD=false PERFETTO_CHROMIUM_BUILD=true PERFETTO_STANDALONE_BUILD=false PERFETTO_START_DAEMONS=true PERFETTO_IPC=true PERFETTO_WATCHDOG=0 PERFETTO_COMPONENT_BUILD=false PERFETTO_ENABLE_ETM_IMPORTER=false PERFETTO_FORCE_DLOG_ON=false PERFETTO_FORCE_DLOG_OFF=true PERFETTO_FORCE_DCHECK_ON=false PERFETTO_FORCE_DCHECK_OFF=false PERFETTO_VERBOSE_LOGS=false PERFETTO_VERSION_GEN=false PERFETTO_TP_PERCENTILE=false PERFETTO_TP_LINENOISE=false PERFETTO_TP_HTTPD=true PERFETTO_TP_JSON=true PERFETTO_TP_INSTRUMENTS=false '\"'\"'PERFETTO_LOCAL_SYMBOLIZER=PERFETTO_BUILDFLAG_DEFINE_PERFETTO_OS_LINUX() || PERFETTO_BUILDFLAG_DEFINE_PERFETTO_OS_MAC() ||PERFETTO_BUILDFLAG_DEFINE_PERFETTO_OS_WIN()'\"'\"' PERFETTO_ZLIB=true PERFETTO_TRACED_PERF=false PERFETTO_HEAPPROFD=false PERFETTO_STDERR_CRASH_DUMP=false PERFETTO_X64_CPU_OPT=false PERFETTO_LLVM_DEMANGLE=false PERFETTO_SYSTEM_CONSUMER=true PERFETTO_THREAD_SAFETY_ANNOTATIONS=false' | " +
         "$(location third_party/perfetto/gn/write_buildflag_header.py) " +
         "--out " +
         "'$(out)' " +
         "--rsp " +
         "/dev/stdin",
    host_supported: true,
    host_cross_supported: false,
    out: [
        "third_party/perfetto/build_config/perfetto_build_flags.h",
    ],
    export_include_dirs: [
        "third_party/perfetto/build_config/",
    ],
    tool_files: [
        "third_party/perfetto/gn/write_buildflag_header.py",
    ],
    apex_available: [
        "com.android.tethering",
    ],
    visibility: [
        "//external/cronet:__subpackages__",
    ],
}

