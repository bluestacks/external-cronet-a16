// GN: //net/android:net_errors_java
genrule {
    name: "tot_cronet_net_android_net_errors_java",
    srcs: [
        ":tot_cronet_net_android_net_errors_java_preprocess",
    ],
    tools: [
        "soong_zip",
    ],
    cmd: "cp $(in) $(genDir)/NetError.java && " +
         "$(location soong_zip) -o $(out) -srcjar -C $(genDir) -f $(genDir)/NetError.java",
    out: [
        "NetError.srcjar",
    ],
    defaults: [
        "tot_cronet_cc_defaults",
    ],
    visibility: [
        "//external/cronet:__subpackages__",
    ],
}

