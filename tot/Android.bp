// GN: //components/cronet:cronet_version_header
cc_genrule {
    name: "tot_cronet_components_cronet_cronet_version_header__concatenated_headers_common",
    cmd: "python $(location components/cronet/gn2bp/headers_copy.py) --gen-dir $(genDir) --headers " +
         "$(locations :tot_cronet_components_cronet_cronet_version_header_action)",
    out: [
        "components/cronet/version.h",
    ],
    tool_files: [
        ":tot_cronet_components_cronet_cronet_version_header_action",
        "components/cronet/gn2bp/headers_copy.py",
    ],
    apex_available: [
        "com.android.tethering",
    ],
}

