    name: "tot_cronet_net_cronet_buildflags",
    cmd: "mkdir -p $(genDir)/net/base &&  " +
         "echo '--flags CRONET_BUILD=true' | " +
         "$(location build/write_buildflag_header.py) " +
         "--output " +
         "'$(out)' " +
