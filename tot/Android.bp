// GN: //third_party/perfetto/src/tracing:client_api_without_backends__testing
cc_genrule {
    name: "tot_cronet_third_party_perfetto_src_tracing_client_api_without_backends__testing__concatenated_headers_host",
    cmd: "python $(location components/cronet/gn2bp/headers_copy.py) --gen-dir $(genDir) --headers " +
         "$(locations :tot_cronet_build_chromeos_buildflags__testing)",
    host_supported: true,
    host_cross_supported: false,
    out: [
        "build/chromeos_buildflags.h",
    ],
    tool_files: [
        ":tot_cronet_build_chromeos_buildflags__testing",
        "components/cronet/gn2bp/headers_copy.py",
    ],
    apex_available: [
        "com.android.tethering",
    ],
}

