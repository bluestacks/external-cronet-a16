         "external/cronet/tot/third_party/perfetto/protos/perfetto/trace/ui_state.proto " +
         "--plugin=protoc-gen-plugin=$(location tot_cronet_third_party_perfetto_src_protozero_protoc_plugin_cppgen_plugin__testing) " +
         "--plugin_out=wrapper_namespace=gen:$(genDir)/third_party/perfetto//",
