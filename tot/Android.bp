        "external/cronet/tot/third_party/libc++abi/src/include",
        "external/cronet/tot/third_party/perfetto/include/",
        "external/cronet/tot/third_party/protobuf/src/",
        "external/cronet/tot/third_party/re2/src/",
    ],
    cpp_std: "c++20",
    ldflags: [
        "-Wl,--as-needed",
        "-Wl,--gc-sections",
        "-Wl,--icf=all",
        "-Wl,--script,external/cronet/tot/base/android/library_loader/anchor_functions.lds",
    ],
    stem: "libcronet_unittests_android__library",
    visibility: [
        "//external/cronet:__subpackages__",
        "//packages/modules/Connectivity:__subpackages__",
    ],
    target: {
        android_arm: {
            cflags: [
                "-D_FORTIFY_SOURCE=2",
            ],
        },
        android_arm64: {
            cflags: [
                "-D_FORTIFY_SOURCE=2",
                "-D__ARM_NEON__=1",
                "-O2",
                "-mno-outline",
            ],
        },
        android_x86: {
            cflags: [
                "-D_FORTIFY_SOURCE=2",
                "-msse3",
            ],
        },
        android_x86_64: {
            cflags: [
                "-D_FORTIFY_SOURCE=2",
                "-O2",
                "-msse3",
            ],
        },
    },
}

