    ],
    defaults: [
        "tot_cronet_cc_defaults",
    ],
    cflags: [
        "-DANDROID",
        "-DDYNAMIC_ANNOTATIONS_ENABLED=0",
        "-DHAVE_SYS_UIO_H",
        "-DNDEBUG",
        "-DNVALGRIND",
        "-DOFFICIAL_BUILD",
        "-D_GNU_SOURCE",
        "-D_LIBCPP_DISABLE_VISIBILITY_ANNOTATIONS",
        "-D_LIBCPP_HARDENING_MODE=_LIBCPP_HARDENING_MODE_EXTENSIVE",
        "-D_LIBCPP_INSTRUMENTED_WITH_ASAN=0",
        "-D_LIBCXXABI_DISABLE_VISIBILITY_ANNOTATIONS",
        "-D__ANDROID_UNAVAILABLE_SYMBOLS_ARE_WEAK__",
        "-D__STDC_CONSTANT_MACROS",
        "-D__STDC_FORMAT_MACROS",
        "-fdata-sections",
        "-ffunction-sections",
        "-fstack-protector",
        "-fvisibility-inlines-hidden",
        "-fvisibility=hidden",
        "-g1",
    ],
    include_dirs: [
        "external/cronet/tot/",
        "external/cronet/tot/buildtools/third_party/libc++/",
        "external/cronet/tot/third_party/libc++/src/include",
        "external/cronet/tot/third_party/libc++abi/src/include",
    ],
    cpp_std: "c++20",
    ldflags: [
        "-Wl,--as-needed",
        "-Wl,--gc-sections",
        "-Wl,--icf=all",
    ],
    visibility: [
        "//external/cronet:__subpackages__",
    ],
    target: {
        android_arm: {
            cflags: [
                "-D_FORTIFY_SOURCE=2",
            ],
        },
        android_arm64: {
            cflags: [
                "-D_FORTIFY_SOURCE=2",
                "-D__ARM_NEON__=1",
                "-O2",
                "-mno-outline",
            ],
        },
        android_x86: {
            cflags: [
                "-D_FORTIFY_SOURCE=2",
                "-msse3",
            ],
        },
        android_x86_64: {
            cflags: [
                "-D_FORTIFY_SOURCE=2",
                "-O2",
                "-msse3",
            ],
        },
    },
}

