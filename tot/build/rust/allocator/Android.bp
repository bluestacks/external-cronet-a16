                "-D_LARGEFILE64_SOURCE",
                "-D_LARGEFILE_SOURCE",
                "-O2",
                "-fno-asynchronous-unwind-tables",
                "-fno-unwind-tables",
                "-msse3",
            ],
            ldflags: [
                "-Wl,--icf=all",
            ],
        },
    },
}
