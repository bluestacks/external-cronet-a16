    ],
    visibility: [
        "//external/cronet:__subpackages__",
    ],
    target: {
        android_arm64: {
            cflags: [
                "-D__ARM_NEON__=1",
                "-O2",
                "-mno-outline",
            ],
        },
        android_x86: {
